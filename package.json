{
  "name": "@dustinedwards/site-api",
  "version": "0.32.0",
  "private": true,
  "description": "The standard site API every Dustin Edwards site includes so Carrel can list, edit and publish its content.",
  "license": "MIT",
  "bin": {
    "site-api-live": "bin/site-api-live.mjs"
  },
  "files": [
    "dist",
    "bin"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./admin": {
      "types": "./dist/admin.d.ts",
      "default": "./dist/admin.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./frontmatter": {
      "types": "./dist/frontmatter.d.ts",
      "default": "./dist/frontmatter.js"
    },
    "./schedules": {
      "types": "./dist/schedules.d.ts",
      "default": "./dist/schedules.js"
    },
    "./store": {
      "types": "./dist/store.d.ts",
      "default": "./dist/store.js"
    },
    "./r2": {
      "types": "./dist/r2.d.ts",
      "default": "./dist/r2.js"
    },
    "./conformance": {
      "types": "./dist/conformance.d.ts",
      "default": "./dist/conformance.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "lint": "oxlint --type-aware --deny-warnings --report-unused-disable-directives-severity=error",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "bloat": "devkit-no-bloat"
  },
  "dependencies": {
    "diff": "9.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@drdustinedwards/site-helpers": "github:DrDustinEdwards/prelum#v0.40.0",
    "@dustinedwards/devkit": "github:DrDustinEdwards/devkit#v0.27.0",
    "@dustinedwards/site-runtime": "github:DrDustinEdwards/site-runtime#v0.102.0",
    "@types/node": "26.6.6",
    "@vitest/coverage-v8": "4.1.12",
    "oxfmt": "0.77.0",
    "oxlint": "1.92.0",
    "oxlint-tsgolint": "7.0.2006",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  },
  "peerDependencies": {
    "@drdustinedwards/site-helpers": ">=0.35.1",
    "@dustinedwards/site-runtime": ">=0.102.0"
  },
  "engines": {
    "node": ">=26.11.1"
  }
}
