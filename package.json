{
  "name": "@dustinedwards/site-api",
  "version": "0.8.0",
  "private": true,
  "description": "The standard site API every Dustin Edwards site includes so Carrel can list, edit and publish its content.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=26.11.1"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./admin": {
      "types": "./dist/admin.d.ts",
      "default": "./dist/admin.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./frontmatter": {
      "types": "./dist/frontmatter.d.ts",
      "default": "./dist/frontmatter.js"
    },
    "./conformance": {
      "types": "./dist/conformance.d.ts",
      "default": "./dist/conformance.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "lint:promises": "oxlint --type-aware --tsconfig tsconfig.json src"
  },
  "dependencies": {
    "@dustinedwards/site-runtime": "github:DrDustinEdwards/site-runtime#v0.9.0",
    "diff": "9.0.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "22.20.0",
    "@vitest/coverage-v8": "4.1.11",
    "oxlint": "1.87.0",
    "oxlint-tsgolint": "7.0.2003",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
